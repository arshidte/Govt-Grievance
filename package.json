{
  "name": "panchayat-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @pg/citizen test:e2e && pnpm --filter @pg/admin test:e2e",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@pg/config": "workspace:*",
    "eslint": "^9.12.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
