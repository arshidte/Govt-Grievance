# API
# -- Database roles (M4D least-privilege separation; see apps/api/docs/db-least-privilege.md) --
# DATABASE_URL  = RUNTIME (Prisma Client / live API) connection. In a hardened
#                 setup this is the least-privilege role `app_runtime`
#                 (DML only; INSERT-but-not-UPDATE/DELETE on AuditLog; never
#                 superuser/owner). Replace the password placeholder.
DATABASE_URL=postgresql://app_runtime:CHANGE_ME_runtime_pw@localhost:5435/panchayat?schema=public
# DIRECT_DATABASE_URL = ADMIN/MIGRATION connection (schema owner). Used ONLY by
#                 `prisma migrate|db` tooling and by the test harness (which
#                 seeds + purges append-only rows). Never used by the live API.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/panchayat?schema=public
# RUNTIME_DATABASE_URL = TEST-ONLY. Same role/creds as DATABASE_URL above; read
#                 by the least-privilege verification spec to connect AS the
#                 runtime role. Leave unset to skip that spec.
RUNTIME_DATABASE_URL=postgresql://app_runtime:CHANGE_ME_runtime_pw@localhost:5435/panchayat?schema=public
# Runtime role credentials consumed by `pnpm --filter @pg/api db:provision-runtime-role`
# (must match the password used in DATABASE_URL/RUNTIME_DATABASE_URL above).
RUNTIME_DB_USER=app_runtime
RUNTIME_DB_PASSWORD=CHANGE_ME_runtime_pw
API_PORT=4000
CORS_ORIGIN_CITIZEN=http://localhost:3000
CORS_ORIGIN_ADMIN=http://localhost:3001
SESSION_COOKIE_NAME=pg_session
SESSION_TTL_HOURS=720
# Validity window (seconds) of a pending staff-onboarding record (login OTP lifetime is owned by MSG91)
OTP_TTL_SECONDS=300
# Per-IP request limit for /auth/* routes within a 60s window (default 5 — strict).
# TEST-ONLY override: the Playwright browser e2e raises this; it MUST NOT be set in
# production (the API rejects any non-default value at boot when NODE_ENV=production).
AUTH_THROTTLE_LIMIT=5
# Max on-behalf issues one representative may file per rolling hour (fail-safe default 20)
ON_BEHALF_RATE_LIMIT_PER_HOUR=20

# -- MSG91 OTP widget (authentication) — see apps/api/docs/msg91-otp.md --
# Server verifier mode. 'mock' (dev/test) trusts a `test-otp:<phone>` token so the
# suite/local dev can log in without MSG91; 'live' validates real widget tokens.
# The API refuses to boot with 'mock' when NODE_ENV=production.
MSG91_PROVIDER=mock
# Server-side secret ("authkey") — REQUIRED when MSG91_PROVIDER=live. Never commit a real value.
MSG91_AUTHKEY=
# Optional override of the MSG91 verify endpoint (defaults to the control.msg91.com v5 URL).
# MSG91_VERIFY_URL=https://control.msg91.com/api/v5/widget/verifyAccessToken

# Local-disk attachment storage root (dev-only; outside any web root) — see apps/api/src/attachments/storage/local-disk.storage.ts
ATTACHMENT_STORAGE_DIR=.data/attachments

# Web (citizen/admin)
API_INTERNAL_URL=http://localhost:4000
# MSG91 widget — CLIENT config (exposed to the browser). 'mock' skips the external
# widget script and uses a test token; set 'live' + the widget id/token-auth in prod.
NEXT_PUBLIC_MSG91_PROVIDER=mock
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=

# Dev-login phones seeded by `apps/api/prisma/seed.ts` (Task 16) — clearly
# fake numbers, usable only against a local/dev DB. With SMS_PROVIDER=mock,
# the real OTP code is never logged (plaintext codes are never logged, per
# project constraint) — MockSmsProvider just holds the last message/code
# in memory per phone instead of sending real SMS (see Task 23 dev endpoint
# for retrieving it).
#   ADMIN:          +919000000001
#   COORDINATOR:    +919000000002  (scoped to Demo Grama Panchayat, code DEMO-GP-01)
#   REPRESENTATIVE: +919000000003  (scoped to Ward 1)
#   REPRESENTATIVE: +919000000004  (scoped to Ward 2)
