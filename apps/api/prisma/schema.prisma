generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDINATOR
  REPRESENTATIVE
  CITIZEN
}

enum UserStatus {
  active
  disabled
}

enum Language {
  en
  ml
}

// Canonical grievance/issue lifecycle statuses (mirrors @pg/types
// IssueStatusEnum — the single source of truth). M2 activates only
// SUBMITTED/ACKNOWLEDGED/IN_PROGRESS/RESOLVED via the transition
// validator; the remaining values are defined but dormant until a later
// milestone.
enum IssueStatus {
  SUBMITTED
  ACKNOWLEDGED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_INFORMATION
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

// Canonical grievance priority levels (mirrors @pg/types PriorityEnum).
// M2 fixes every issue's priority at MEDIUM (no client/staff editing).
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                  String               @id @default(cuid())
  phone               String               @unique
  email               String?
  fullName            String?
  preferredLanguage   Language             @default(en)
  status              UserStatus           @default(active)
  addressLine         String?
  wardId              String?
  ward                Ward?                @relation(fields: [wardId], references: [id])
  roleAssignments     RoleAssignment[]
  sessions            Session[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  // issue-domain back-relations (M2):
  issuesAsCitizen     Issue[]              @relation("issueCitizen")
  issuesCreated       Issue[]              @relation("issueCreatedBy")
  notifications       Notification[]
  statusChanges       IssueStatusHistory[] @relation("statusHistoryChangedBy")
  attachmentsUploaded Attachment[]         @relation("attachmentUploadedBy")
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("login")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RoleAssignment {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        Role
  panchayatId String?
  panchayat   Panchayat? @relation(fields: [panchayatId], references: [id])
  wardId      String?
  ward        Ward?      @relation(fields: [wardId], references: [id])
  grantedBy   String?
  createdAt   DateTime   @default(now())

  // Uniqueness + role<->scope coherence are enforced by PARTIAL unique
  // indexes and a CHECK constraint (raw SQL, not expressible in Prisma
  // schema) — see migration 20261015000000_roleassignment_integrity. A plain
  // `@@unique([userId, role, panchayatId, wardId])` is INEFFECTIVE here
  // because PostgreSQL treats NULL scope columns as distinct, so it is
  // intentionally omitted in favour of the partial indexes.
}

model Panchayat {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  nameMl          String
  contactPhone    String?
  contactEmail    String?
  status          String           @default("active")
  wards           Ward[]
  roleAssignments RoleAssignment[]
  issues          Issue[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Ward {
  id              String           @id @default(cuid())
  number          Int
  name            String
  nameMl          String
  panchayatId     String
  panchayat       Panchayat        @relation(fields: [panchayatId], references: [id])
  status          String           @default("active")
  roleAssignments RoleAssignment[]
  users           User[]
  issues          Issue[]

  @@unique([panchayatId, number])
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  nameMl        String
  sortOrder     Int           @default(0)
  subcategories Subcategory[]
  issues        Issue[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  nameMl     String
  issues     Issue[]
}

// ---- Issue domain ----
model Issue {
  id            String               @id @default(cuid())
  referenceNo   String               @unique
  title         String
  description   String
  status        IssueStatus          @default(SUBMITTED)
  priority      Priority             @default(MEDIUM)
  citizenId     String
  citizen       User                 @relation("issueCitizen", fields: [citizenId], references: [id])
  createdById   String
  createdBy     User                 @relation("issueCreatedBy", fields: [createdById], references: [id])
  onBehalfOf    Boolean              @default(false)
  panchayatId   String
  panchayat     Panchayat            @relation(fields: [panchayatId], references: [id])
  wardId        String
  ward          Ward                 @relation(fields: [wardId], references: [id])
  categoryId    String
  category      Category             @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory?         @relation(fields: [subcategoryId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  assignments   IssueAssignment[]
  statusHistory IssueStatusHistory[]
  escalations   Escalation[]
  attachments   Attachment[]
  notifications Notification[]
}

model IssueAssignment {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id])
  assigneeId String
  createdAt  DateTime @default(now())
}

model IssueStatusHistory {
  id           String        @id @default(cuid())
  issueId      String
  issue        Issue         @relation(fields: [issueId], references: [id])
  // Nullable by design: legacy/backfilled rows (pre-M2) have no recorded
  // actor and must not be given an invented one — see spec §4.5. M2
  // application logic always populates this for newly-created rows.
  changedById  String?
  changedBy    User?         @relation("statusHistoryChangedBy", fields: [changedById], references: [id])
  fromStatus   IssueStatus
  toStatus     IssueStatus
  note         String?
  createdAt    DateTime      @default(now())
  notification Notification?
}

model Escalation {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  createdAt DateTime @default(now())
}

model Attachment {
  id           String   @id @default(cuid())
  issueId      String
  issue        Issue    @relation(fields: [issueId], references: [id])
  uploadedById String
  uploadedBy   User     @relation("attachmentUploadedBy", fields: [uploadedById], references: [id])
  storageKey   String
  mimeType     String
  sizeBytes    Int
  originalName String
  createdAt    DateTime @default(now())
}

model Notification {
  id              String              @id @default(cuid())
  recipientId     String
  recipient       User                @relation(fields: [recipientId], references: [id])
  issueId         String?
  issue           Issue?              @relation(fields: [issueId], references: [id])
  type            String
  statusHistoryId String?             @unique
  statusHistory   IssueStatusHistory? @relation(fields: [statusHistoryId], references: [id])
  readAt          DateTime?
  createdAt       DateTime            @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
