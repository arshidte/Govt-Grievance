generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection used by the live API (Prisma Client). In a hardened
  // deployment this points at the LEAST-PRIVILEGE application role
  // (`app_runtime`): DML only, INSERT-but-not-UPDATE/DELETE on AuditLog,
  // never a superuser or schema owner. See docs/db-least-privilege.md.
  url = env("DATABASE_URL")
  // Privileged connection used ONLY by Prisma Migrate / schema tooling
  // (`prisma migrate deploy|dev`, `db push`, `migrate diff`). Points at the
  // MIGRATION/ADMIN role (schema owner) — never used by the running API.
  // Prisma Client ignores `directUrl`, so the API boots with `url` alone.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  COORDINATOR
  REPRESENTATIVE
  CITIZEN
}

enum UserStatus {
  active
  disabled
}

enum Language {
  en
  ml
}

// Admin-initiated staff onboarding lifecycle (staff-onboarding milestone).
// A `StaffOnboarding` row holds the PENDING intent to grant a staff role;
// it deliberately creates NO `RoleAssignment` until OTP verification, so a
// pending onboarding can never grant authorization. `expired` is derived
// lazily (a pending row past `expiresAt`) and may also be persisted.
enum OnboardingStatus {
  pending
  verified
  cancelled
  expired
}

// Canonical grievance/issue lifecycle statuses (mirrors @pg/types
// IssueStatusEnum — the single source of truth). M2 activates only
// SUBMITTED/ACKNOWLEDGED/IN_PROGRESS/RESOLVED via the transition
// validator; the remaining values are defined but dormant until a later
// milestone.
enum IssueStatus {
  SUBMITTED
  ACKNOWLEDGED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_INFORMATION
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

// Canonical grievance priority levels (mirrors @pg/types PriorityEnum).
// M2 fixes every issue's priority at MEDIUM (no client/staff editing).
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                  String               @id @default(cuid())
  phone               String               @unique
  email               String?
  fullName            String?
  preferredLanguage   Language             @default(en)
  status              UserStatus           @default(active)
  addressLine         String?
  wardId              String?
  ward                Ward?                @relation(fields: [wardId], references: [id])
  roleAssignments     RoleAssignment[]
  sessions            Session[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  // issue-domain back-relations (M2):
  issuesAsCitizen     Issue[]              @relation("issueCitizen")
  issuesCreated       Issue[]              @relation("issueCreatedBy")
  notifications       Notification[]
  statusChanges       IssueStatusHistory[] @relation("statusHistoryChangedBy")
  attachmentsUploaded Attachment[]         @relation("attachmentUploadedBy")
  staffOnboardings    StaffOnboarding[]    @relation("onboardingUser")
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("login")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RoleAssignment {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        Role
  panchayatId String?
  panchayat   Panchayat? @relation(fields: [panchayatId], references: [id])
  wardId      String?
  ward        Ward?      @relation(fields: [wardId], references: [id])
  grantedBy   String?
  // Soft-revocation (org-management milestone): an assignment is ACTIVE while
  // `revokedAt` is NULL and REVOKED once stamped. Revoked rows are never
  // deleted (assignment history is preserved) and must no longer grant
  // authorization — `AccessControlService` only ever loads active rows.
  // `revokedBy` mirrors the relation-less `grantedBy` (actor id, no FK).
  // The partial unique indexes are recreated WITH `revokedAt IS NULL` so
  // uniqueness constrains only ACTIVE assignments (a user may be re-assigned
  // to a ward/panchayat they were previously revoked from). See migration
  // 20261109000000_org_mgmt_soft_revoke.
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime   @default(now())

  // Uniqueness + role<->scope coherence are enforced by PARTIAL unique
  // indexes and a CHECK constraint (raw SQL, not expressible in Prisma
  // schema) — see migrations 20261015000000_roleassignment_integrity and
  // 20261109000000_org_mgmt_soft_revoke. A plain
  // `@@unique([userId, role, panchayatId, wardId])` is INEFFECTIVE here
  // because PostgreSQL treats NULL scope columns as distinct, so it is
  // intentionally omitted in favour of the partial indexes.
}

model Panchayat {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  nameMl          String
  contactPhone    String?
  contactEmail    String?
  status          String           @default("active")
  wards           Ward[]
  roleAssignments RoleAssignment[]
  issues          Issue[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Ward {
  id              String           @id @default(cuid())
  number          Int
  name            String
  nameMl          String
  panchayatId     String
  panchayat       Panchayat        @relation(fields: [panchayatId], references: [id])
  status          String           @default("active")
  roleAssignments RoleAssignment[]
  users           User[]
  issues          Issue[]

  @@unique([panchayatId, number])
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  nameMl        String
  sortOrder     Int           @default(0)
  subcategories Subcategory[]
  issues        Issue[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  nameMl     String
  issues     Issue[]
}

// ---- Issue domain ----
model Issue {
  id            String               @id @default(cuid())
  referenceNo   String               @unique
  title         String
  description   String
  status        IssueStatus          @default(SUBMITTED)
  priority      Priority             @default(MEDIUM)
  citizenId     String
  citizen       User                 @relation("issueCitizen", fields: [citizenId], references: [id])
  createdById   String
  createdBy     User                 @relation("issueCreatedBy", fields: [createdById], references: [id])
  onBehalfOf    Boolean              @default(false)
  panchayatId   String
  panchayat     Panchayat            @relation(fields: [panchayatId], references: [id])
  wardId        String
  ward          Ward                 @relation(fields: [wardId], references: [id])
  categoryId    String
  category      Category             @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory?         @relation(fields: [subcategoryId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  assignments   IssueAssignment[]
  statusHistory IssueStatusHistory[]
  escalations   Escalation[]
  attachments   Attachment[]
  notifications Notification[]
}

model IssueAssignment {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id])
  assigneeId String
  createdAt  DateTime @default(now())
}

model IssueStatusHistory {
  id           String        @id @default(cuid())
  issueId      String
  issue        Issue         @relation(fields: [issueId], references: [id])
  // Nullable by design: legacy/backfilled rows (pre-M2) have no recorded
  // actor and must not be given an invented one — see spec §4.5. M2
  // application logic always populates this for newly-created rows.
  changedById  String?
  changedBy    User?         @relation("statusHistoryChangedBy", fields: [changedById], references: [id])
  fromStatus   IssueStatus
  toStatus     IssueStatus
  note         String?
  createdAt    DateTime      @default(now())
  notification Notification?
}

model Escalation {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  createdAt DateTime @default(now())
}

model Attachment {
  id           String   @id @default(cuid())
  issueId      String
  issue        Issue    @relation(fields: [issueId], references: [id])
  uploadedById String
  uploadedBy   User     @relation("attachmentUploadedBy", fields: [uploadedById], references: [id])
  storageKey   String
  mimeType     String
  sizeBytes    Int
  originalName String
  createdAt    DateTime @default(now())
}

model Notification {
  id              String              @id @default(cuid())
  recipientId     String
  recipient       User                @relation(fields: [recipientId], references: [id])
  issueId         String?
  issue           Issue?              @relation(fields: [issueId], references: [id])
  type            String
  statusHistoryId String?             @unique
  statusHistory   IssueStatusHistory? @relation(fields: [statusHistoryId], references: [id])
  readAt          DateTime?
  createdAt       DateTime            @default(now())
}

// Creation-idempotency replay store (M2 Task 6). Standalone/no relations by
// design: a userId that no longer resolves to a User must not block replay
// lookups, and this table's lifecycle (24h TTL purge, Task 9) is intentionally
// decoupled from User/Issue cascade behaviour.
model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String
  userId       String
  route        String
  fingerprint  String
  responseJson Json
  issueId      String?
  createdAt    DateTime @default(now())

  @@unique([userId, route, key])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  // Supports the audit-log viewer's universal ordering (`createdAt DESC,
  // id DESC`), its `from`/`to` range scans, and the compound keyset cursor
  // (M4A). A composite on exactly the sort keys lets Postgres satisfy the
  // ORDER BY + pagination from an index scan instead of a sort.
  @@index([createdAt, id])
}

// Admin-initiated staff onboarding (staff-onboarding milestone). Holds the
// PENDING intent to grant a staff role (REPRESENTATIVE/COORDINATOR) to a phone
// number, gated by OTP phone-ownership verification. Crucially, NO
// `RoleAssignment` exists until `status` becomes `verified` — so a pending
// onboarding grants zero authorization by construction (the session layer only
// ever sees real, active assignments). On verification the user is upserted by
// phone and one active assignment is created per target scope id.
//
// `wardIds` is populated for REPRESENTATIVE onboarding, `panchayatIds` for
// COORDINATOR (one or more active scopes). A PARTIAL unique index (migration)
// allows at most ONE `pending` row per phone, so a phone can't be claimed by a
// second concurrent onboarding.
model StaffOnboarding {
  id           String           @id @default(cuid())
  phone        String
  // Set when an EXISTING user was selected; null when onboarding a brand-new
  // phone (the user is upserted by phone at verification time).
  userId       String?
  user         User?            @relation("onboardingUser", fields: [userId], references: [id])
  role         Role
  wardIds      String[]
  panchayatIds String[]
  status       OnboardingStatus @default(pending)
  // Snapshot of the OTP challenge window; also used to derive `expired`.
  expiresAt    DateTime
  createdBy    String // admin user id (actor)
  verifiedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([phone, status])
  @@index([status, createdAt])
}
