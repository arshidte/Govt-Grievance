generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDINATOR
  REPRESENTATIVE
  CITIZEN
}

enum UserStatus {
  active
  disabled
}

enum Language {
  en
  ml
}

model User {
  id                String     @id @default(cuid())
  phone             String     @unique
  email             String?
  fullName          String?
  preferredLanguage Language   @default(en)
  status            UserStatus @default(active)
  addressLine       String?
  wardId            String?
  ward              Ward?      @relation(fields: [wardId], references: [id])
  roleAssignments   RoleAssignment[]
  sessions          Session[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  // issue-domain back-relations (M2):
  issuesAsCitizen   Issue[]        @relation("issueCitizen")
  issuesCreated     Issue[]        @relation("issueCreatedBy")
  notifications     Notification[]
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("login")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RoleAssignment {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        Role
  panchayatId String?
  panchayat   Panchayat? @relation(fields: [panchayatId], references: [id])
  wardId      String?
  ward        Ward?      @relation(fields: [wardId], references: [id])
  grantedBy   String?
  createdAt   DateTime   @default(now())

  @@unique([userId, role, panchayatId, wardId])
}

model Panchayat {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  nameMl          String
  contactPhone    String?
  contactEmail    String?
  status          String   @default("active")
  wards           Ward[]
  roleAssignments RoleAssignment[]
  issues          Issue[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Ward {
  id              String   @id @default(cuid())
  number          Int
  name            String
  nameMl          String
  panchayatId     String
  panchayat       Panchayat @relation(fields: [panchayatId], references: [id])
  status          String    @default("active")
  roleAssignments RoleAssignment[]
  users           User[]
  issues          Issue[]

  @@unique([panchayatId, number])
}

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameMl        String
  sortOrder     Int      @default(0)
  subcategories Subcategory[]
  issues        Issue[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  nameMl     String
}

// ---- Issue domain: relationships fixed now, fields in M2 ----
model Issue {
  id            String   @id @default(cuid())
  referenceNo   String   @unique
  citizenId     String
  citizen       User     @relation("issueCitizen", fields: [citizenId], references: [id])
  createdById   String
  createdBy     User     @relation("issueCreatedBy", fields: [createdById], references: [id])
  onBehalfOf    Boolean  @default(false)
  panchayatId   String
  panchayat     Panchayat @relation(fields: [panchayatId], references: [id])
  wardId        String
  ward          Ward     @relation(fields: [wardId], references: [id])
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  createdAt     DateTime @default(now())
  assignments   IssueAssignment[]
  statusHistory IssueStatusHistory[]
  escalations   Escalation[]
  attachments   Attachment[]
  notifications Notification[]
}

model IssueAssignment {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id])
  assigneeId String
  createdAt  DateTime @default(now())
}

model IssueStatusHistory {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  status    String
  createdAt DateTime @default(now())
}

model Escalation {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  createdAt DateTime @default(now())
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id])
  storageKey String
  createdAt  DateTime @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id])
  issueId     String?
  issue       Issue?    @relation(fields: [issueId], references: [id])
  type        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
